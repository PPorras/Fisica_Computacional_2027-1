# --- Entorno virtual (ver README.md, sección de instalación) ---
.venv/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Salidas de simulaciones y gráficas ---
# Cada unidad genera datos (csv, txt, npy, ...) con Python y figuras
# (png, pdf, eps, svg) con gnuplot; no hace falta versionarlas porque
# se regeneran corriendo el código y los scripts .gp de la unidad.
unidades/*/datos/*
unidades/*/figuras/*
!unidades/*/datos/.gitkeep
!unidades/*/figuras/.gitkeep
simulaciones/*/datos/*
simulaciones/*/figuras/*
!simulaciones/*/datos/.gitkeep
!simulaciones/*/figuras/.gitkeep

# --- Soluciones de referencia (NO deben ver los estudiantes) ---
solucion_practica_*/

# Soluciones ya publicadas (prácticas cerradas): se quitan de la regla
# de arriba una por una, al cerrar cada práctica.
!practicas/practica1/solucion_practica_01/
!practicas/practica2/solucion_practica_02/
!practicas/practica3/solucion_practica_03/
# Datos que generan las soluciones si se corren en su carpeta.
practicas/*/solucion_practica_*/datos/

# --- Editores ---
*.swp
*.swo
*~
.netrwhist

# --- Sistema operativo ---
.DS_Store
Thumbs.db
